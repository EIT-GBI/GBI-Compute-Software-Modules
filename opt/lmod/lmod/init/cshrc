#!/bin/csh
# -*- shell-script -*-
########################################################################
#  This is the system wide source file for setting up
#  modules:
#
########################################################################

set MY_NAME="/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/init/cshrc"

if ( ! $?LMOD_ALLOW_ROOT_USE ) then
  set LMOD_ALLOW_ROOT_USE=yes
endif

set my_id = `id -u`
if ( $LMOD_ALLOW_ROOT_USE != yes && $my_id == 0 ) then
  exit
endif

if ( ! $?MODULEPATH_ROOT ) then
    if ( $?USER) then
        setenv USER $LOGNAME
    endif

    set UNAME = `uname`
    setenv LMOD_sys             $UNAME
    setenv MODULEPATH_ROOT      "/Users/johannes.blaschke/Developer/cli-util-mods/opt/modulefiles"
    if ( ! $?LMOD_MODULEPATH_INIT ) then
        if ( -f /etc/lmod/.modulespath ) then
           set LMOD_MODULEPATH_INIT = "/etc/lmod/.modulespath"
        else
          set LMOD_MODULEPATH_INIT = "/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/init/.modulespath"
        endif
    endif
    if ( -f $LMOD_MODULEPATH_INIT ) then
       	foreach str (`cat $LMOD_MODULEPATH_INIT | sed 's/#.*$//'`)	# Allow end-of-line comments.
	   foreach dir ( $str )
              if ( -d $dir ) then
                 setenv MODULEPATH `/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/libexec/addto --append MODULEPATH $dir`
              endif
           end
	end
    else
       setenv MODULEPATH `/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/libexec/addto --append MODULEPATH $MODULEPATH_ROOT/$LMOD_sys $MODULEPATH_ROOT/Core`
       setenv MODULEPATH `/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/libexec/addto --append MODULEPATH /Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/modulefiles/Core`
    endif

    #################################################################
    # Prepend any directories in LMOD_SITE_MODULEPATH to $MODULEPATH
    #################################################################
    if ( $?LMOD_SITE_MODULEPATH ) then
       setenv MODULEPATH `/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/libexec/addto MODULEPATH $LMOD_SITE_MODULEPATH`
    endif
       
    # Don't reset BASH_ENV if set by USER
    if  ( ! $?BASH_ENV ) then
       setenv BASH_ENV      "/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/init/bash"
    endif

    #
    # If MANPATH is empty, Lmod is adding a trailing ":" so that
    # the system MANPATH will be found
    if ( ! $?MANPATH ) then
      setenv MANPATH :
    endif
    setenv MANPATH `/Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/libexec/addto MANPATH /Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/share/man`

endif

unset LMOD_ALLOW_ROOT_USE my_id UNAME LMOD_sys MODULEPATH_INIT

if ( -f  /Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/init/csh  ) then
  source /Users/johannes.blaschke/Developer/cli-util-mods/opt/lmod/lmod/init/csh
endif

